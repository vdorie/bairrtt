linters: linters_with_defaults(
    # Layout is owned by the air formatter (air.toml, line-width = 80). These
    # linters are disabled where they contradict air's output rather than
    # fighting the formatter: line width (air breaks what it can; the remaining
    # long lines are unbreakable strings and comments) and continuation-line
    # indentation.
    line_length_linter = NULL,
    indentation_linter = NULL,
    # bairrtt is snake_case throughout (irt_causal_bart, n_persons, theta_sd).
    # dotted.case admits the dot-prefixed internal Rcpp shims (.irt_draw_sample,
    # .irt_sampler_tuning); symbols admits operators; UPPERCASE admits matrix
    # names carried over from the C++ signatures (Y).
    object_name_linter(
      styles = c("snake_case", "dotted.case", "symbols", "UPPERCASE")
    ),
    commented_code_linter = NULL,
    # <<- is used for closure state; pin the permission explicitly so a lintr
    # release changing the default does not re-flag it.
    assignment_linter(operator = c("<-", "<<-"))
  )
encoding: "UTF-8"
# Vignette code chunks are formatted for prose exposition, not lint compliance.
# R/RcppExports.R is generated by Rcpp::compileAttributes() and cannot be
# edited to satisfy a linter.
exclusions: list("vignettes", "R/RcppExports.R")
